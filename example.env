# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is gitignored; never commit real keys.

# Adaption key (hackathon credits). If set, models routed to the `adaption`
# provider in config/models.yaml are paid from these credits instead of OpenRouter.
ADAPTION_API_KEY=

# OpenRouter key, from https://openrouter.ai/settings/keys
# Used for: GPT-5 nano (agent), Claude Haiku 5.5 (judge, agent), and the
# open-weight models' fallback route.
# Suggestion: set a $25 credit limit on the key itself as a second safety net.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# OPTIONAL. Hugging Face token, from https://huggingface.co/settings/tokens
# Needs the "Make calls to Inference Providers" permission (a fine-grained token
# or a write token). Leave it blank to use the cached token at
# ~/.cache/huggingface/token; that account currently returns 402 (no credits),
# so open-weight models fall back to OpenRouter automatically.
HF_TOKEN=